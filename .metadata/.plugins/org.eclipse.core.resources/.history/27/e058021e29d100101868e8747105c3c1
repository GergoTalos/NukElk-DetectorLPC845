/**
 * For TIL308 7 segment display with built-in logic
 * Codes:
 * 	0-9
 * 	A:		10
 * 	MINUS:	11
 * 	C:		12
 * 	BLANK:	13
 * 	E:		14
 * 	F:		15
 * 	BLank display(s)
 * 	Light Test display(s) overrides lathes
 * 	Decimal Point for each display
 * 	LS pulse duration = min. 45ns
 * 	Latch data inputs setup time = min. 60ns
 * 	Hold time is 0ns (theoretically)
 */
//#define BCD_BL(X) GPIO_PinWrite(BCD_BL_GPIO, BCD_BL_PORT, BCD_BL_PIN, X); // Blanking pin
#define BCD_LT(X) GPIO_PinWrite(BCD_LT_GPIO, BCD_LT_PORT, BCD_LT_PIN, X); // Light Test pin
#define BCD_DP_0(X) GPIO_PinWrite(BCD_DP_0_GPIO, BCD_DP_0_PORT, BCD_DP_0_PIN, X); // Decimal point pin
//#define BCD_DP_1(X) GPIO_PinWrite(BCD_DP_1_GPIO, BCD_DP_1_PORT, BCD_DP_1_PIN, X); // Decimal point pin

#define BLANK_CODE 13 //blanks the display
#define BCD_DELAY 2 //~ 66ns, ~2 cycles at 30MHz
#define BCD_DELAY_SETUP 1000000 //1s

/**
 * Lower 4 bits are used.
 */
uint8_t BCD_digit(uint8_t digit) {
	uint8_t ret = 1;
	if (digit < 16) {
		BCD_A(0x01 & digit);
		BCD_B((0x02 & digit) >> 1);
		BCD_C((0x04 & digit) >> 2);
		BCD_D((0x08 & digit) >> 3);
		ret = 0;
	}
	return ret;
}


/**
 * int to bcd for two digit, positive only displays
 */
uint8_t BCD_pint2(int8_t num) {
	uint8_t ret = 1;
	if (num < 100 && num > -1) {
		BCD_digit(num % 10);
		BCD_LOAD_0(0);
		num /= 10; // the cpu doesn't have to wait.
		BCD_LOAD_0(1);
		BCD_digit(num % 10);
		BCD_LOAD_1(0);
		nop(BCD_DELAY);
		BCD_LOAD_1(1);
		ret = 0;
	}
	return ret;
}

/**
 * Blanks all digits.
 */
void BCD_blank(void) {
	BCD_digit(13);
	BCD_LOAD_0(0);
	BCD_LOAD_1(0);
	BCD_LOAD_0(1);
	BCD_LOAD_1(1);
}

/*
 * Initialises the 7 segment display, by lighting it up, then blanking it.
 */
void BCD_init() {
	BCD_LT(0); // Lights up, clears
	BCD_digit(BLANK_CODE); //Set blank, but no effect
	nop(BCD_DELAY_SETUP);
	BCD_LOAD_0(0); // Load blank
	BCD_LOAD_1(0);
	BCD_LT(1);
	BCD_LOAD_0(1);
	BCD_LOAD_1(1);
	nop(BCD_DELAY_SETUP);
}


